    {
      "id": "salt",
      "number": "~30",
      "suffix": "%",
      "endpoint": "less bitterness",
      "context": "Model-broth salt study",
      "detail": "Our proposed broth uses sea salt. In a separate NaCl model-chicken-broth study containing L-tryptophan, salt reduced human-rated bitterness by about 30%.",
      "basis": "The study did not test Sorami or our sea salt. The dose and sensory result still need formulation trials.",
      "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6542971/",
      "remaining": 0.7
    },
    {
      "id": "msg",
      "number": "Umami",
      "suffix": "",
      "endpoint": "build the savoury base",
      "context": "MSG · formulation direction",
      "detail": "Use MSG to build savoury depth alongside the grain and broth. Its dose belongs in recipe trials.",
      "basis": "No separate bitterness-reduction percentage is assigned to MSG.",
      "source": "https://pmc.ncbi.nlm.nih.gov/articles/PMC6542971/",
      "remaining": null
    },
    {
      "id": "yeast",
      "number": "≥40",
      "suffix": "%",
      "endpoint": "less response from bitter sensors",
      "context": "Yeast extract · cell study",
      "detail": "At least 40% inhibition in 7 of 19 tested bitter receptors. This measures cells, not perceived taste.",
      "basis": "Published receptor result; not a Sorami taste test.",
      "source": "https://pubmed.ncbi.nlm.nih.gov/38945612/",
      "remaining": 0.6
    }
